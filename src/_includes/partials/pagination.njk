{#- Очаква pg = { number, total, prev, next } -#}
{%- if pg.total > 1 %}
<nav class="pagination" aria-label="{{ 'ui.page' | t(lang) }}">
  {%- if pg.prev %}<a class="btn" href="{{ pg.prev }}">{% icon "arrow-left", 16 %} {{ "ui.newer" | t(lang) }}</a>{% else %}<span></span>{% endif %}
  <span class="pagination-info">{{ "ui.page" | t(lang) }} {{ pg.number }} {{ "ui.of" | t(lang) }} {{ pg.total }}</span>
  {%- if pg.next %}<a class="btn" href="{{ pg.next }}">{{ "ui.older" | t(lang) }} {% icon "arrow-right", 16 %}</a>{% else %}<span></span>{% endif %}
</nav>
{%- endif %}
