{#- Една песен в списъка. Очаква s (песен) и lang. -#}
{%- set rx = neonData.reactions["song:" + s.slug] -%}
{%- set songUrl = "/" + lang + "/songs/" + s.slug + "/" -%}
<li class="song" id="{{ s.slug }}" data-song='{{ { slug: s.slug, title: s.title, artist: s.artist, src: s.src, cover: s.cover, duration: s.duration } | jsonAttr | safe }}'>
  <button type="button" class="song-cover" data-play="{{ s.slug }}" aria-label="{{ 'songs.play' | t(lang) }}: {{ s.title }}">
    {%- if s.cover %}<img src="{{ s.cover }}" alt="" width="96" height="96" loading="lazy" decoding="async" eleventy:ignore>{% else %}<span class="song-cover-placeholder">{% icon "music", 28 %}</span>{% endif %}
    <span class="song-play-overlay">{% icon "play", 26 %}{% icon "pause", 26 %}</span>
  </button>
  <div class="song-body">
    <h2 class="song-title"><a href="{{ songUrl }}">{{ s.title }}</a></h2>
    <p class="song-meta">
      {%- if s.duration %}<span>{% icon "clock", 14 %} {{ s.duration | duration }}</span>{% endif %}
      <span data-plays="song:{{ s.slug }}"{% if not (rx and rx.plays) %} hidden{% endif %}>{% icon "headphones", 14 %} <span data-plays-count>{{ (rx.plays | localeNumber(lang)) if rx and rx.plays else "0" }}</span> {{ "songs.plays" | t(lang) }}</span>
      <span class="song-eq" aria-hidden="true"><i></i><i></i><i></i></span>
    </p>
    <div class="song-actions">
      <button type="button" class="btn btn-small" data-play="{{ s.slug }}">{% icon "play", 16 %} <span>{{ "songs.play" | t(lang) }}</span></button>
      {%- if s.style %}<button type="button" class="btn btn-small" aria-expanded="false" data-panel-toggle="style-{{ s.slug }}">{% icon "sparkles", 16 %} <span>{{ "songs.style" | t(lang) }}</span></button>{% endif %}
      {%- if s.lyrics %}<button type="button" class="btn btn-small" aria-expanded="false" data-panel-toggle="lyrics-{{ s.slug }}">{% icon "quote", 16 %} <span>{{ "songs.lyrics" | t(lang) }}</span></button>{% endif %}
      {%- if s.suno %}<a class="btn btn-small" href="{{ s.suno }}" target="_blank" rel="noopener" data-track="song-suno:{{ s.slug }}">{% icon "suno", 16 %} <span>Suno</span></a>{% endif %}
      <a class="btn btn-small" href="{{ s.download }}" download data-track="song-download:{{ s.slug }}">{% icon "download", 16 %} <span>MP3</span> <small>{{ s.size | bytes }}</small></a>
      <button type="button" class="btn btn-small like-btn" data-like="song:{{ s.slug }}" aria-label="{{ 'ui.like' | t(lang) }}" aria-pressed="false">{% icon "heart", 16 %}<span class="like-count">{{ (rx.likes | localeNumber(lang)) if rx and rx.likes else "" }}</span></button>
      <button type="button" class="btn btn-small" data-share-song="{{ songUrl | toAbsolute }}" data-share-title="{{ s.title }}" data-copied="{{ 'songs.copied' | t(lang) }}" aria-label="{{ 'songs.share' | t(lang) }}" title="{{ 'songs.share' | t(lang) }}">{% icon "share-2", 16 %}</button>
    </div>
    {%- if s.style %}<div class="song-panel" id="style-{{ s.slug }}" hidden><h3>{{ "songs.style" | t(lang) }}</h3><p class="song-style-full">{{ s.style }}</p></div>{% endif %}
    {%- if s.lyrics %}<div class="song-panel" id="lyrics-{{ s.slug }}" hidden><h3>{{ "songs.lyrics" | t(lang) }}</h3><pre class="lyrics">{{ s.lyrics }}</pre></div>{% endif %}
  </div>
</li>
